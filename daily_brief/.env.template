# Daily Ukraine-Russia War Analyst Brief — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.

# -----------------------------------------------------------------------
# REQUIRED: Anthropic API Key
# Get yours at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# -----------------------------------------------------------------------
# REQUIRED for email delivery: Gmail SMTP credentials
#
# GMAIL_SENDER      = the Gmail address that will SEND the report
# GMAIL_APP_PASSWORD = a Gmail App Password (NOT your account password)
#
# How to create a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create an app password for "Mail" / "Other (Custom name)"
#   5. Copy the 16-character password here
# -----------------------------------------------------------------------
GMAIL_SENDER=your.sending.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# -----------------------------------------------------------------------
# RECIPIENT (default: ericjsanchez23@gmail.com)
# -----------------------------------------------------------------------
GMAIL_RECIPIENT=ericjsanchez23@gmail.com
